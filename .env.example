# Copy to .env for local development only. Never commit real secrets.
# Production secrets are mounted as read-only files, not env values (plan 9.5, 15.3).

APP_ENV=development

# PostgreSQL: source of truth, authoritative for session validity and revocation
DATABASE_URL=postgresql+psycopg://ciphercontact:changeme@localhost:5432/ciphercontact

# Redis: non-authoritative session cache and background-job broker
REDIS_URL=redis://localhost:6379/0

# Session and CSRF
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Keyed HMAC for phone fingerprints (dev only; real key in separate custody, versioned)
PHONE_FINGERPRINT_HMAC_KEY=dev-only-change-me
PHONE_FINGERPRINT_KEY_VERSION=1

# Field encryption (dev only; real key in separate custody, versioned)
FIELD_ENCRYPTION_KEY=dev-only-change-me
FIELD_ENCRYPTION_KEY_VERSION=1

# Upload limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=100000

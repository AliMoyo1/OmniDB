# Copy to .env for LOCAL development only. Never commit real secrets.
# In production, secret values are mounted as files under /run/secrets (see deploy/secrets),
# and pydantic-settings reads them by field name. Non-secret config stays in the environment.

APP_ENV=development

# LAN host Caddy serves the HTTPS site on (set to the server LAN IP in production)
SERVER_HOST=localhost

# PostgreSQL connection parts (the password is a secret, see below / secret file)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ciphercontact
DB_USER=ciphercontact

# Redis (non-authoritative session cache and Celery broker)
REDIS_URL=redis://redis:6379/0

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Key versions (the key material itself lives in secret files)
FIELD_ENCRYPTION_KEY_VERSION=1
PHONE_FINGERPRINT_KEY_VERSION=1

# Localization / jurisdiction (configurable; Zimbabwe baseline)
DEFAULT_TIMEZONE=Africa/Harare
JURISDICTION=ZW

# Upload limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=100000

# --- Local-dev secrets only (production uses files in /run/secrets instead) ---
DB_PASSWORD=dev-only-change-me
APP_SECRET_KEY=dev-only-change-me
FIELD_ENCRYPTION_KEY=dev-only-change-me
PHONE_FINGERPRINT_HMAC_KEY=dev-only-change-me

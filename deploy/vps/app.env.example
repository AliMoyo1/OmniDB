# Copy to /srv/ciphercontact/config/app.env on the VPS. This file contains only
# non-secret settings. The five runtime secrets come from root-readable files
# in /srv/ciphercontact/secrets and are mounted at /run/secrets.

APP_ENV=production
SERVER_HOST=ciphercontact.example.invalid

DB_NAME=ciphercontact
DB_USER=ciphercontact

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
STEP_UP_MINUTES=10

FIELD_ENCRYPTION_KEY_VERSION=1
PHONE_FINGERPRINT_KEY_VERSION=1

DEFAULT_TIMEZONE=Africa/Harare
JURISDICTION=ZW

UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_EXPANDED_BYTES=209715200
UPLOAD_MAX_ROWS=100000
UPLOAD_MAX_COLUMNS=50
UPLOAD_MAX_CELL_LENGTH=500
IMPORT_EXPIRY_HOURS=72

LOG_LEVEL=INFO
CELERY_TASK_ALWAYS_EAGER=false
LEASE_DURATION_MINUTES=15
MAX_SKIPS_BEFORE_REVIEW=3
COOKIE_SECURE=true

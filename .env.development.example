# Copy to .env only for local development outside the production Compose workflow.
# These values are intentionally non-production and startup validation rejects them
# whenever APP_ENV=production.

APP_ENV=development
SERVER_HOST=localhost
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciphercontact
DB_USER=ciphercontact
DB_PASSWORD=dev-only-change-me
REDIS_URL=redis://localhost:6379/0
APP_SECRET_KEY=dev-only-change-me
FIELD_ENCRYPTION_KEY=dev-only-change-me
PHONE_FINGERPRINT_HMAC_KEY=dev-only-change-me
HEALTH_TOKEN=dev-only-change-me
COOKIE_SECURE=false
CELERY_TASK_ALWAYS_EAGER=true
